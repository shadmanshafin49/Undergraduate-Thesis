# Claude / editor
.claude/

# Python
__pycache__/
*.pyc

# Large datasets — download from Kaggle, never commit.
# creditcard.csv is 143.8 MB and exceeds GitHub's 100 MB limit outright; the
# BankSim files are smaller but there is no reason to carry 82 MB of
# regenerable Kaggle data in the history.
#   kaggle datasets download -d mlg-ulb/creditcardfraud --unzip
#   kaggle datasets download -d ealaxi/banksim1 --unzip
creditcard.csv
datasets/creditcard.csv
datasets/bs140513_032310.csv
datasets/bsNET140513_032310.csv

# Fraud Detection Handbook (OBJ-5 / OBJ-16) — 183 daily pickles upstream, plus
# the CSV data/handbook_loader.py consolidates them into on first use.
#   git clone --depth 1 \
#     https://github.com/Fraud-Detection-Handbook/simulated-data-raw.git \
#     datasets/handbook_raw
datasets/handbook_raw/
datasets/handbook_transactions.csv

# PaySim (OBJ-11) — Kaggle ealaxi/paysim1, 6.36M rows, ~470 MB: never commit.
#   kaggle datasets download -d ealaxi/paysim1 --unzip -p datasets/paysim
datasets/paysim/

# IBM AMLSim (OBJ-12) — simulator source, local build tools and generated
# output. Regenerated from the pinned commit + the configuration recorded in
# TASK.md, so none of it belongs in the history.
datasets/amlsim/

# Hyperledger Fabric binaries — re-download via the official install script
fabric/fabric-samples/bin/

# LaTeX build artifacts — regenerated on compile (main.pdf is kept)
*.aux
*.bcf
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nlo
*.out
*.run.xml
*.toc
*.synctex.gz

# ...but `*.log` above was written for LaTeX and was silently swallowing
# EXPERIMENT run logs, which are provenance, not build artifacts: they carry
# the wall-clock, the per-cell ordering and the environment banner for runs
# that cost hours and are not cheap to repeat. Keep those.
!db_boa_framework/results/**/*.log

# Windows "downloaded from internet" metadata
*:Zone.Identifier

# Derived cache for the OBJ-2/OBJ-4 seed sweep (32 MB, regenerated by
# `python experiments/detector_multiseed.py --build-cache`). The per-run
# JSONs beside it are small and ARE tracked -- they are the provenance.
db_boa_framework/results/_multiseed_runs/*.npz


kaggle.md